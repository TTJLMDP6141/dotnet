@model List<Booking>
@{
    ViewData["Title"] = "My bookings";
}
<div class="dashboard-heading">
    <div><span class="eyebrow">APPOINTMENT HISTORY</span><h1>My bookings</h1><p class="text-secondary mb-0">Manage appointments and review completed work.</p></div>
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Book a service</a>
</div>
<section class="panel mt-4">
    @if (Model.Count == 0)
    {
        <div class="empty-inline"><p>You don’t have any bookings yet.</p><a asp-controller="Home" asp-action="Index">Browse services</a></div>
    }
    else
    {
        <div class="table-responsive"><table class="table align-middle"><thead><tr><th>Service</th><th>Date / time</th><th>Provider</th><th>Status</th><th>Total</th><th>Actions</th></tr></thead><tbody>
        @foreach (var booking in Model)
        {
            <tr>
                <td><strong>@booking.Service.Name</strong></td>
                <td>@booking.BookingDate.ToString("dd MMM yyyy")<br /><small class="text-secondary">@booking.BookingTime</small></td>
                <td>@(booking.ProviderProfile?.User.FullName ?? "Not assigned")</td>
                <td><span class="status-badge">@booking.Status.ToString().Replace('_', ' ')</span></td>
                <td>₹@booking.TotalPrice.ToString("0.00")</td>
                <td class="actions-cell">
                    @if (booking.Status is BookingStatus.PENDING or BookingStatus.ACCEPTED)
                    {
                        <form asp-action="Cancel" asp-route-id="@booking.Id" method="post"><button class="btn btn-sm btn-outline-danger" type="submit">Cancel</button></form>
                    }
                    @if (booking.Status == BookingStatus.COMPLETED && booking.Review is null)
                    {
                        <a asp-action="Review" asp-route-id="@booking.Id" class="btn btn-sm btn-outline-primary">Review</a>
                    }
                    @if (booking.Review is not null)
                    {
                        <span class="text-secondary small">Reviewed · @booking.Review.Rating/5</span>
                    }
                </td>
            </tr>
        }
        </tbody></table></div>
    }
</section>
