@model Booking
@{
    ViewData["Title"] = "Booking confirmed";
}
<section class="confirmation-card">
    <div class="confirmation-check">✓</div>
    <span class="eyebrow">REQUEST RECEIVED</span>
    <h1 class="mt-2">Your booking is in.</h1>
    <p class="text-secondary">The provider will review your appointment request.</p>
    <div class="confirmation-details">
        <div><span>Service</span><strong>@Model.Service.Name</strong></div>
        <div><span>Date &amp; time</span><strong>@Model.BookingDate.ToString("dd MMM yyyy") · @Model.BookingTime</strong></div>
        <div><span>Address</span><strong>@Model.Address</strong></div>
        <div><span>Total</span><strong>₹@Model.TotalPrice.ToString("0.00")</strong></div>
        <div><span>Status</span><strong>@Model.Status</strong></div>
    </div>
    <a asp-action="Bookings" class="btn btn-primary mt-4">View my bookings</a>
</section>
