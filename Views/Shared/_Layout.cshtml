<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · Urban Services</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark app-nav">
    <div class="container">
        <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index"><span class="brand-mark">U</span> Urban Services</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="mainNav">
            <div class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
                <a class="nav-link" asp-controller="Home" asp-action="Index">Services</a>
                @if (User.IsInRole("CUSTOMER"))
                {
                    <a class="nav-link" asp-controller="Customer" asp-action="Index">My dashboard</a>
                    <a class="nav-link" asp-controller="Customer" asp-action="Bookings">My bookings</a>
                    <a class="nav-link" asp-controller="Customer" asp-action="Profile">Profile</a>
                }
                @if (User.IsInRole("PROVIDER"))
                {
                    <a class="nav-link" asp-controller="Provider" asp-action="Index">Provider dashboard</a>
                }
                @if (User.IsInRole("ADMIN"))
                {
                    <a class="nav-link" asp-controller="Admin" asp-action="Index">Admin dashboard</a>
                }
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <form asp-controller="Account" asp-action="Logout" method="post" class="ms-lg-2">
                        <button type="submit" class="btn btn-outline-light btn-sm">Sign out</button>
                    </form>
                }
                else
                {
                    <a class="nav-link" asp-controller="Account" asp-action="Login">Sign in</a>
                    <a class="btn btn-light btn-sm px-3" asp-controller="Account" asp-action="Register">Create account</a>
                }
            </div>
        </div>
    </div>
</nav>
<main class="container py-4 py-lg-5">
    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">@success<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div>
    }
    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">@error<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div>
    }
    @RenderBody()
</main>
<footer class="border-top py-4 mt-4">
    <div class="container d-flex flex-column flex-sm-row justify-content-between gap-2 text-secondary small">
        <span>Urban Services · Home care, made simpler</span>
        <span>Book trusted help for everyday tasks.</span>
    </div>
</footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
