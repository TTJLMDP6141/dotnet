@model ProviderProfileVm
@{
    ViewData["Title"] = "Provider profile";
}
<div class="auth-wrap"><section class="auth-card">
    <span class="eyebrow">PROVIDER DETAILS</span><h1 class="h2 mt-2">Your profile</h1>
    <form asp-action="Profile" method="post" class="mt-4">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <div class="mb-3"><label asp-for="FullName" class="form-label">Full name</label><input asp-for="FullName" class="form-control" /><span asp-validation-for="FullName" class="text-danger"></span></div>
        <div class="mb-3"><label asp-for="Phone" class="form-label">Phone</label><input asp-for="Phone" class="form-control" /><span asp-validation-for="Phone" class="text-danger"></span></div>
        <div class="mb-3"><label asp-for="Experience" class="form-label">Years of experience</label><input asp-for="Experience" class="form-control" min="0" /><span asp-validation-for="Experience" class="text-danger"></span></div>
        <div class="mb-4"><label asp-for="Availability" class="form-label"></label><input asp-for="Availability" class="form-control" /><span asp-validation-for="Availability" class="text-danger"></span></div>
        <button class="btn btn-primary" type="submit">Save profile</button>
        <a asp-action="Index" class="btn btn-link">Back to dashboard</a>
    </form>
</section></div>
