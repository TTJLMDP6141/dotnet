@model AdminDashboardVm
@{
    ViewData["Title"] = "Admin dashboard";
}
<div class="dashboard-heading">
    <div><span class="eyebrow">PLATFORM OVERVIEW</span><h1>Administration</h1><p class="text-secondary mb-0">Manage people, services and appointments.</p></div>
    <a asp-action="Bookings" class="btn btn-primary">Manage bookings</a>
</div>
<div class="row g-3 my-4">
    <div class="col-6 col-lg-3"><div class="stat-card"><span>Customers</span><strong>@Model.CustomerCount</strong></div></div>
    <div class="col-6 col-lg-3"><div class="stat-card"><span>Providers</span><strong>@Model.ProviderCount</strong></div></div>
    <div class="col-6 col-lg-3"><div class="stat-card"><span>Services</span><strong>@Model.ServiceCount</strong></div></div>
    <div class="col-6 col-lg-3"><div class="stat-card"><span>Bookings</span><strong>@Model.BookingCount</strong></div></div>
</div>
<div class="admin-shortcuts mb-4">
    <a asp-action="Customers" class="shortcut-card"><span>01</span><strong>Customers</strong><small>View registered customers →</small></a>
    <a asp-action="Providers" class="shortcut-card"><span>02</span><strong>Providers</strong><small>View provider profiles →</small></a>
    <a asp-action="Services" class="shortcut-card"><span>03</span><strong>Services</strong><small>Edit the service catalog →</small></a>
</div>
<section class="panel">
    <div class="panel-heading"><h2 class="h4 mb-0">Recent bookings</h2><a asp-action="Bookings" class="text-link">Manage all →</a></div>
    @if (Model.RecentBookings.Count == 0)
    {
        <div class="empty-inline">No bookings yet.</div>
    }
    else
    {
        <div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Customer</th><th>Service</th><th>Date</th><th>Status</th><th>Total</th></tr></thead><tbody>
        @foreach (var booking in Model.RecentBookings)
        {
            <tr><td>@booking.Customer.FullName</td><td>@booking.Service.Name</td><td>@booking.BookingDate.ToString("dd MMM yyyy")</td><td><span class="status-badge">@booking.Status.ToString().Replace('_', ' ')</span></td><td>₹@booking.TotalPrice.ToString("0.00")</td></tr>
        }
        </tbody></table></div>
    }
</section>
